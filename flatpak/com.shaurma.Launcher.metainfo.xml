<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.shaurma.Launcher</id>
  <name>Shaurma Launcher</name>
  <summary>Minecraft launcher for Shaurma modpacks</summary>
  <summary xml:lang="uk">Лаунчер Minecraft для збірок Shaurma</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="com.shaurma">
    <name>Shaurma</name>
  </developer>
  <description>
    <p>Shaurma Launcher installs, updates and launches Minecraft modpacks. The launcher updates itself from the project releases on GitHub.</p>
    <p xml:lang="uk">Shaurma Launcher встановлює, оновлює й запускає збірки Minecraft. Лаунчер оновлюється сам із релізів проєкту на GitHub.</p>
  </description>
  <categories>
    <category>Game</category>
  </categories>
  <launchable type="desktop-id">com.shaurma.Launcher.desktop</launchable>
  <content_rating type="oars-1.1" />
  <url type="homepage">https://shaurma-launcher.org/</url>
  <url type="vcs-browser">https://github.com/B23101/Shaurma-Launcher</url>
  <releases>
    <release version="@VERSION@" date="@DATE@" />
  </releases>
</component>
